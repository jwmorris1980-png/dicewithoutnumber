[Unit]
Description=Dice Without Number Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/DICEwithoutNumber
ExecStart=/home/ubuntu/DICEwithoutNumber/venv/bin/python3 bot.py
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/DICEwithoutNumber/bot.log
StandardError=append:/home/ubuntu/DICEwithoutNumber/bot.log

[Install]
WantedBy=multi-user.target
