#!/bin/bash
TARGET="/home/ubuntu/DICEwithoutNumber"
GIT_DIR="/home/ubuntu/bot.git"

# Sync branch metadata
git --git-dir=$GIT_DIR symbolic-ref HEAD refs/heads/main

# Force checkout using sudo to ensure permissions
sudo git --work-tree=$TARGET --git-dir=$GIT_DIR checkout -f main
echo "Code deployed to $TARGET"

# HARDEN: Restore ownership to ubuntu user after checkout
echo "Restoring ownership to ubuntu user..."
sudo chown -R ubuntu:ubuntu $TARGET

# Keep service definitions and the independent watchdog current.
sudo cp "$TARGET/dicewithoutnumber.service" /etc/systemd/system/
sudo cp "$TARGET/dicewithoutnumber-watchdog.service" /etc/systemd/system/
sudo cp "$TARGET/dicewithoutnumber-watchdog.timer" /etc/systemd/system/
sudo systemctl daemon-reload
sudo systemctl enable --now dicewithoutnumber-watchdog.timer

# Restart
sudo systemctl restart dicewithoutnumber.service
echo "Bot service restarted."
sudo systemctl restart imagecatalog.service
echo "Image catalog service restarted."
